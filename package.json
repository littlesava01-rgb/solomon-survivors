{
  "name": "solomon-survivors",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "«Белка Соломон» — игра в жанре Vampire Survivors: Соломон отбивается от школьной атрибутики.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
